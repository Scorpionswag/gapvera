# Copy this file to server/.env and fill in what you want.
# GapVera runs fine with none of it: scraping returns clearly-labelled fake
# results and emails are logged instead of sent, so you can learn the whole
# app before spending a cent.

# ---------------------------------------------------------------------------
# Google Maps: turns Scrape Leads into real business data
# ---------------------------------------------------------------------------
# console.cloud.google.com -> new project -> enable billing -> enable
# "Places API (New)" -> Credentials -> create an API key -> restrict the key
# to Places API (New).
#
# Two traps that will cost you an hour if you miss them:
#   1. It must be "Places API (New)". The legacy "Places API" cannot be
#      enabled on new Google Cloud projects at all.
#   2. Enabling the API on the project and allowing it on the key are two
#      separate switches. Do both, or you get PERMISSION_DENIED.
#
# Usage is one request per search, so the free monthly allowance goes a long
# way. Set a budget alert anyway.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Email: turns the composer into real sending
# ---------------------------------------------------------------------------
# Any SMTP host works. The cheapest setup is a Gmail account with 2-Step
# Verification on and an App Password (Google Account > Security > App
# passwords). Use the app password below, not your normal password.
#
# To send from your own domain, add the address as a verified "Send mail as"
# alias in Gmail first, then put it in SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# The hourly follow-up job only sends when this is exactly "true".
# Leave it false to approve every outreach email yourself. Recommended until
# you trust your own templates.
AUTO_FOLLOWUPS=false

# Default "How to pay" block printed on every new invoice. Use \n for line
# breaks, e.g. "Zelle to 555-555-0100\nChecks payable to Your Name\nNet 14"
INVOICE_PAYMENT_INSTRUCTIONS=

# Port for the API. Deliberately not called PORT, because some dev tooling
# injects PORT and would collide with the web server.
API_PORT=3001

# Copy this file to server/.env and fill in what you want.
#
# NOTE (zero-cost build): the Express server this file configured is gone.
# GapVera is now a Cloudflare Pages site talking to Supabase, so these values
# live in the Pages project's environment variables, not in a .env file on a
# machine. The names are unchanged, and server/.env is still where a local
# copy of the Google key is kept for the test harness.
#
# Where each value goes now:
#   GOOGLE_MAPS_API_KEY  -> Cloudflare Pages -> Settings -> Environment
#                           variables -> Production, marked ENCRYPTED. Read by
#                           functions/api/places/search.js at the edge. It must
#                           never be given a VITE_ prefix: that would inline it
#                           into the browser bundle for anyone to take.
#   SMTP_*                -> not used. Email sending is unavailable in this
#                           build; the composer saves drafts instead.
#   CARTO_API_KEY         -> not used. The map is OpenStreetMap, no credential.
#   API_PORT, AUTO_FOLLOWUPS, INVOICE_PAYMENT_INSTRUCTIONS
#                         -> not used. No Express server to configure.

# ---------------------------------------------------------------------------
# Google Maps: turns the Scrape page into real business lookups
# ---------------------------------------------------------------------------
# console.cloud.google.com -> new project -> enable billing -> enable
# "Places API (New)" -> Credentials -> create an API key -> restrict the key
# to Places API (New).
#
# Two traps that will cost you an hour if you miss them:
#   1. It must be "Places API (New)". The legacy "Places API" cannot be
#      enabled on new Google Cloud projects at all.
#   2. Enabling the API on the project and allowing it on the key are two
#      separate switches. Do both, or you get PERMISSION_DENIED.
#
# Cost: one billable Text Search request per lookup, never retried. GapVera
# also enforces its own 25/day and 300/month caps server-side, which sit well
# inside Google's 5,000 free requests per month for this SKU. Set a budget
# alert and a key restriction anyway — GapVera's caps bound normal use, but
# only a key restriction bounds a leaked key.
#
# Unset is a supported state: the lookup fails closed and the page says so.
# It never invents results.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Email: turns the composer into real sending
# ---------------------------------------------------------------------------
# Any SMTP host works. The cheapest setup is a Gmail account with 2-Step
# Verification on and an App Password (Google Account > Security > App
# passwords). Use the app password below, not your normal password.
#
# To send from your own domain, add the address as a verified "Send mail as"
# alias in Gmail first, then put it in SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# The hourly follow-up job only sends when this is exactly "true".
# Leave it false to approve every outreach email yourself. Recommended until
# you trust your own templates.
AUTO_FOLLOWUPS=false

# Default "How to pay" block printed on every new invoice. Use \n for line
# breaks, e.g. "Zelle to 555-555-0100\nChecks payable to Your Name\nNet 14"
INVOICE_PAYMENT_INSTRUCTIONS=

# Port for the API. Deliberately not called PORT, because some dev tooling
# injects PORT and would collide with the web server.
API_PORT=3001

{
  "name": "gapvera",
  "version": "0.1.0",
  "private": true,
  "description": "Web Design Sales CRM - leads, outreach, pipeline, clients, call tracking",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client",
    "test": "node --test client/src/*.test.mjs migration/migration.test.mjs",
    "test:client": "node --test client/src/*.test.mjs",
    "test:migration": "node --test migration/migration.test.mjs",
    "migrate:export": "node migration/export-sqlite.mjs server/crm.db migration/export",
    "migrate:verify": "node migration/reconcile.mjs migration/export"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
